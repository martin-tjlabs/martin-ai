{
  "name": "martin-ai",
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/highlighter": "./src/lib/highlighter.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "build": "tsdown && tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "dev:js": "tsdown --watch",
    "dev:css": "tailwindcss -i src/styles.css -o dist/styles.css --watch",
    "dev": "pnpm run \"/^dev:.*/\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.177",
    "@base-ui/react": "^1.9.0",
    "@shadcn/react": "^0.3.1",
    "ai": "^7.0.173",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.73.0",
    "shiki": "^4.6.0",
    "streamdown": "^2.7.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4.3.5",
    "tsdown": "^0.23.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2"
  }
}
