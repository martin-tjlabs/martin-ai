# 이 파일을 .env로 복사해 값을 채운다. .env는 git에서 제외된다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# 화면에서 고를 수 있는 모델. "회사:모델명"을 쉼표로 나열하고 첫 번째가 기본값.
# 비워 두면 대본 모드. 예: anthropic:claude-sonnet-5-5,openai:gpt-5,google:gemini-2.5-pro
CHAT_MODELS=
# 브라우저가 보는 주소. FLOW 로그인 뒤 돌아올 콜백 주소를 만든다.
# 비워 두면 http://localhost:<PLAYGROUND_PORT, 기본 5180>을 쓴다.
# playground 포트만 바꿀 때는 PUBLIC_URL 대신 루트에서 PLAYGROUND_PORT=3000 pnpm dev처럼 실행한다.
# PUBLIC_URL=http://localhost:5180
# 개발용: 1이면 FLOW 로그인으로 받은 토큰을 서버 터미널에 출력한다. 기본은 꺼짐.
# FLOW_DEBUG_PRINT_TOKENS=1
