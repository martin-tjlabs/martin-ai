# 이 파일을 .env로 복사해 값을 채운다. .env는 git에서 제외된다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# 화면에서 고를 수 있는 모델. "회사:모델명"을 쉼표로 나열하고 첫 번째가 기본값.
# 비워 두면 대본 모드. 예: anthropic:claude-sonnet-5-5,openai:gpt-5,google:gemini-2.5-pro
CHAT_MODELS=
# 브라우저가 보는 주소. FLOW 로그인 뒤 돌아올 콜백 주소를 만든다. 기본값은 playground.
# PUBLIC_URL=http://localhost:5173
